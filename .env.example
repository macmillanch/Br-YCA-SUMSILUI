# MongoDB Atlas connection string for the yca_sumsilui database.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/yca_sumsilui?retryWrites=true&w=majority
# Database name the app reads and writes.
MONGODB_DB=yca_sumsilui
# Database the Playwright specs truncate. Keep it separate from MONGODB_DB.
MONGODB_DB_TEST=yca_sumsilui_test

# bcrypt cost factor. Leave at 12 in production; tests override to 4.
BCRYPT_ROUNDS=12

# Cloudinary, for gallery photo uploads. Server-side only — never expose the secret.
# Without these the gallery still works: a picture is added by its web address.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Not read by this site — uploads are signed with the API secret on the server.
CLOUDINARY_UPLOAD_PRESET=

# Initial super-admin created by `npm run seed`. Change the password after first login.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
